@model Gradution_Project_G5.BLL.ViewModels.SessionsVM.SessionVM
@{
    ViewData["Title"] = "Session Details";
}

<h1><i class="fas fa-info-circle"></i> Session Details</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Title:</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Course:</dt>
            <dd class="col-sm-8">@Model.CourseName</dd>

            <dt class="col-sm-4">Start Date:</dt>
            <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">End Date:</dt>
            <dd class="col-sm-8">@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Duration:</dt>
            <dd class="col-sm-8">@Model.Duration.ToString("F1") hours</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>