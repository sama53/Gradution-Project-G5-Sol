@model Gradution_Project_G5.BLL.ViewModels.SessionsVM.SessionVM
@{
    ViewData["Title"] = "Session Details";
}

<style>
    :root {
        --primary: #2563eb; --primary-light: #eff6ff;
        --accent: #f59e0b; --accent-dark: #d97706;
        --success: #10b981;
        --border: #e2e8f0; --text: #0f172a; --text-muted: #64748b;
        --surface: #ffffff; --radius: 14px; --radius-sm: 8px;
        --shadow-md: 0 4px 24px rgba(0,0,0,0.08);
    }
    .page-wrapper { max-width: 680px; margin: 2.5rem auto; padding: 0 1.5rem; font-family: 'Segoe UI', system-ui, sans-serif; }
    .page-header { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 2px solid var(--border); }
    .page-title { font-size: 1.8rem; font-weight: 800; color: var(--text); display: flex; align-items: center; gap: 0.75rem; }
    .page-title i { color: var(--primary); }
    .details-card { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow-md); border: 1px solid var(--border); overflow: hidden; }
    .details-header { background: linear-gradient(135deg, #1e293b, #0f172a); padding: 1.5rem 2rem; display: flex; align-items: center; gap: 1rem; }
    .header-icon { width: 52px; height: 52px; border-radius: var(--radius-sm); background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.4rem; flex-shrink: 0; }
    .header-text h2 { margin: 0 0 0.2rem; font-size: 1.3rem; font-weight: 700; color: white; }
    .header-text p { margin: 0; color: rgba(255,255,255,0.65); font-size: 0.88rem; }
    .details-body { padding: 2rem; }
    .detail-row { display: flex; padding: 1rem 0; border-bottom: 1px solid var(--border); align-items: center; gap: 1rem; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 130px; flex-shrink: 0; font-weight: 700; color: var(--text-muted); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 0.4rem; }
    .detail-label i { color: var(--primary); }
    .detail-value { color: var(--text); font-size: 0.98rem; flex: 1; font-weight: 500; }
    .course-chip { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--primary-light); color: var(--primary); padding: 0.3rem 0.85rem; border-radius: 999px; font-size: 0.88rem; font-weight: 600; }
    .duration-chip { display: inline-flex; align-items: center; gap: 0.4rem; background: #f0fdf4; color: var(--success); padding: 0.3rem 0.85rem; border-radius: 999px; font-size: 0.88rem; font-weight: 700; }
    .form-actions { display: flex; gap: 0.75rem; padding: 1.5rem 2rem; background: #f8fafc; border-top: 1px solid var(--border); }
    .btn-edit { background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: var(--radius-sm); font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(245,158,11,0.3); transition: all 0.2s; }
    .btn-edit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(245,158,11,0.4); color: white; }
    .btn-back { background: transparent; color: var(--text-muted); border: 2px solid var(--border); padding: 0.65rem 1.4rem; border-radius: var(--radius-sm); font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; transition: all 0.2s; }
    .btn-back:hover { border-color: var(--text-muted); color: var(--text); transform: translateY(-1px); }
</style>

<div class="page-wrapper">
    <div class="page-header">
        <h1 class="page-title"><i class="fas fa-info-circle"></i> Session Details</h1>
    </div>

    <div class="details-card">
        <div class="details-header">
            <div class="header-icon"><i class="fas fa-calendar-alt"></i></div>
            <div class="header-text">
                <h2>@Model.Title</h2>
                <p>@Model.CourseName</p>
            </div>
        </div>

        <div class="details-body">
            <div class="detail-row">
                <span class="detail-label"><i class="fas fa-book"></i> Course</span>
                <span class="detail-value"><span class="course-chip"><i class="fas fa-book"></i> @Model.CourseName</span></span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fas fa-play"></i> Start Date</span>
                <span class="detail-value">@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fas fa-stop"></i> End Date</span>
                <span class="detail-value">@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fas fa-clock"></i> Duration</span>
                <span class="detail-value"><span class="duration-chip"><i class="fas fa-clock"></i> @Model.Duration.ToString("F1") hours</span></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit"><i class="fas fa-edit"></i> Edit</a>
            <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i> Back to List</a>
        </div>
    </div>
</div>
