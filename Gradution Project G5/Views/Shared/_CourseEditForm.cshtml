@model Gradution_Project_G5.BLL.ViewModels.CoursesVM.CourseEditVM

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Category" class="control-label"></label>
            <select asp-for="Category" class="form-control"
                    asp-items="Html.GetEnumSelectList<Gradution_Project_G5.DAL.Models.Categories>()">
                <option value="">Select Category</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="InstructorId" class="control-label">Instructor</label>
            <select asp-for="InstructorId" class="form-control">
                <option value="">Select Instructor</option>
                @foreach (var instructor in ViewBag.Instructors as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    <option value="@instructor.Value">@instructor.Text</option>
                }
            </select>
            <span asp-validation-for="InstructorId" class="text-danger"></span>
        </div>

    </div>
</div>