@model Gradution_Project_G5.BLL.ViewModels.CoursesVM.CourseVM
@{
    ViewData["Title"] = "Course Details";
}

<h1><i class="fas fa-info-circle"></i> Course Details</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Name:</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Description:</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">Category:</dt>
            <dd class="col-sm-8">@Model.Category</dd>

            <dt class="col-sm-4">Instructor:</dt>
            <dd class="col-sm-8">@Model.InstructorName</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>