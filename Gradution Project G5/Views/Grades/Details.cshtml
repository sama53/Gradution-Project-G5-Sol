@model Gradution_Project_G5.BLL.ViewModels.GradesVM.GradeVM
@{
    ViewData["Title"] = "Grade Details";
}

<h1><i class="fas fa-info-circle"></i> Grade Details</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Trainee:</dt>
            <dd class="col-sm-8">@Model.TraineeName</dd>

            <dt class="col-sm-4">Session:</dt>
            <dd class="col-sm-8">@Model.SessionTitle</dd>

            <dt class="col-sm-4">Course:</dt>
            <dd class="col-sm-8">@Model.CourseName</dd>

            <dt class="col-sm-4">Grade:</dt>
            <dd class="col-sm-8">
                <span class="badge
                    @(Model.Value >= 85 ? "bg-success" :
                                            Model.Value >= 75 ? "bg-info" :
                                            Model.Value >= 50 ? "bg-warning" : "bg-danger")">
                    @Model.Value
                </span>
            </dd>

            <dt class="col-sm-4">Status:</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.Value >= 50 ? "bg-success" : "bg-danger")">
                    @(Model.Value >= 50 ? "Pass" : "Fail")
                </span>
            </dd>

            <dt class="col-sm-4">Performance:</dt>
            <dd class="col-sm-8">
                @if (Model.Value >= 85)
                {
                    <span class="text-success">Excellent</span>
                }
                else if (Model.Value >= 75)
                {
                    <span class="text-info">Very Good</span>
                }
                else if (Model.Value >= 50)
                {
                    <span class="text-warning">Good</span>
                }
                else
                {
                    <span class="text-danger">Needs Improvement</span>
                }
            </dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>