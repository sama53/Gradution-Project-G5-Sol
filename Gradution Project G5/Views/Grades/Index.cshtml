@model Gradution_Project_G5.BLL.ViewModels.PagedResult<Gradution_Project_G5.BLL.ViewModels.GradesVM.GradeVM>
@{
    ViewData["Title"] = "Grades";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-chart-bar"></i> Grades</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New
    </a>
</div>

<!-- Filter Form -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <select name="sessionId" class="form-control" asp-items="ViewBag.Sessions">
                <option value="">Filter by Session</option>
            </select>
        </div>
        <div class="col-md-4">
            <select name="traineeId" class="form-control" asp-items="ViewBag.Trainees">
                <option value="">Filter by Trainee</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">
                <i class="fas fa-filter"></i> Filter
            </button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-danger w-100">Clear</a>
        </div>
    </div>
</form>

@if (Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Trainee</th>
                    <th>Session</th>
                    <th>Course</th>
                    <th>Grade</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.TraineeName</td>
                        <td>@item.SessionTitle</td>
                        <td>@item.CourseName</td>
                        <td>
                            <span class="badge
                                        @(item.Value >= 85 ? "bg-success" :
                                                                    item.Value >= 75 ? "bg-info" :
                                                                    item.Value >= 50 ? "bg-warning" : "bg-danger")">
                        @item.Value
                    </span>
                </td>
                <td>
                    <span class="badge @(item.Value >= 50 ? "bg-success" : "bg-danger")">
                        @(item.Value >= 50 ? "Pass" : "Fail")
                    </span>
                </td>
                <td class="table-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i>
                    </a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this grade?')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
                        }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize, sessionId = ViewBag.SessionId, traineeId = ViewBag.TraineeId })">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-warning text-center">
        <i class="fas fa-exclamation-triangle"></i> No grades found.
    </div>
}