@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4 mb-4">Welcome to Gradution Project G5</h1>
    <p class="lead">A comprehensive Course Management System built with ASP.NET Core MVC</p>

    <div class="row mt-5">
        <div class="col-md-3 mb-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <i class="fas fa-book fa-3x mb-3"></i>
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Manage your courses and assign instructors</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-light">View Courses</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <i class="fas fa-calendar-alt fa-3x mb-3"></i>
                    <h5 class="card-title">Sessions</h5>
                    <p class="card-text">Schedule and manage course sessions</p>
                    <a asp-controller="Sessions" asp-action="Index" class="btn btn-light">View Sessions</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <i class="fas fa-users fa-3x mb-3"></i>
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Manage users with different roles</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-light">View Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <i class="fas fa-chart-bar fa-3x mb-3"></i>
                    <h5 class="card-title">Grades</h5>
                    <p class="card-text">Track and manage student grades</p>
                    <a asp-controller="Grades" asp-action="Index" class="btn btn-light">View Grades</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5><i class="fas fa-cogs"></i> System Features</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Three-Tier Architecture</li>
                        <li class="list-group-item">Repository Pattern & Unit of Work</li>
                        <li class="list-group-item">Client & Server Side Validation</li>
                        <li class="list-group-item">Pagination & Search</li>
                        <li class="list-group-item">Responsive UI with Bootstrap</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>