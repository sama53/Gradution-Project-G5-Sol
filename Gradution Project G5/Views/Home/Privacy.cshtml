@{
    ViewData["Title"] = "Privacy Policy";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Privacy Policy for Gradution Project G5</h5>
                <p class="card-text">
                    This privacy policy explains how we collect, use, and protect your personal information
                    in our Course Management System.
                </p>

                <h6>Information We Collect</h6>
                <ul>
                    <li>User names and email addresses</li>
                    <li>Course and session information</li>
                    <li>Student grades and performance data</li>
                    <li>System usage statistics</li>
                </ul>

                <h6>How We Use Your Information</h6>
                <ul>
                    <li>To manage courses and user accounts</li>
                    <li>To track student progress and grades</li>
                    <li>To improve system functionality</li>
                    <li>To communicate important updates</li>
                </ul>

                <h6>Data Protection</h6>
                <p>
                    We implement appropriate security measures to protect your personal information
                    against unauthorized access, alteration, or disclosure.
                </p>

                <h6>Contact Information</h6>
                <p>
                    If you have any questions about this privacy policy, please contact our support team.
                </p>
            </div>
        </div>
    </div>
</div>