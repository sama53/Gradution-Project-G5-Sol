@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-wrapper { max-width: 780px; margin: 0 auto; font-family: 'Segoe UI', system-ui, sans-serif; }
    .page-header { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 2px solid #e2e8f0; }
    .page-title { font-size: 1.8rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 0.75rem; }
    .page-title i { color: #2563eb; }
    .privacy-card { background: white; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 16px rgba(0,0,0,0.08); overflow: hidden; }
    .privacy-hero { background: linear-gradient(135deg, #1e293b, #0f172a); padding: 2rem; }
    .privacy-hero h2 { color: white; font-size: 1.2rem; font-weight: 700; margin: 0 0 0.4rem; }
    .privacy-hero p { color: rgba(255,255,255,0.65); font-size: 0.9rem; margin: 0; line-height: 1.5; }
    .privacy-body { padding: 2rem; }
    .privacy-section { margin-bottom: 2rem; }
    .privacy-section:last-child { margin-bottom: 0; }
    .section-title { display: flex; align-items: center; gap: 0.6rem; font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #eff6ff; }
    .section-title i { color: #2563eb; width: 20px; text-align: center; }
    .privacy-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .privacy-list li { display: flex; align-items: flex-start; gap: 0.6rem; color: #475569; font-size: 0.93rem; line-height: 1.5; }
    .privacy-list li::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #2563eb; flex-shrink: 0; margin-top: 6px; }
    .privacy-text { color: #475569; font-size: 0.93rem; line-height: 1.6; margin: 0; }
    .contact-card { background: #eff6ff; border-radius: 10px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1rem; }
    .contact-card i { font-size: 1.5rem; color: #2563eb; flex-shrink: 0; }
    .contact-card p { margin: 0; color: #1e40af; font-size: 0.93rem; font-weight: 500; }
</style>

<div class="privacy-wrapper">
    <div class="page-header">
        <h1 class="page-title"><i class="fas fa-shield-alt"></i> Privacy Policy</h1>
    </div>

    <div class="privacy-card">
        <div class="privacy-hero">
            <h2>Privacy Policy for Course Academy</h2>
            <p>This privacy policy explains how we collect, use, and protect your personal information in our Course Management System.</p>
        </div>

        <div class="privacy-body">
            <div class="privacy-section">
                <h3 class="section-title"><i class="fas fa-database"></i> Information We Collect</h3>
                <ul class="privacy-list">
                    <li>User names and email addresses</li>
                    <li>Course and session information</li>
                    <li>Student grades and performance data</li>
                    <li>System usage statistics</li>
                </ul>
            </div>

            <div class="privacy-section">
                <h3 class="section-title"><i class="fas fa-cogs"></i> How We Use Your Information</h3>
                <ul class="privacy-list">
                    <li>To manage courses and user accounts</li>
                    <li>To track student progress and grades</li>
                    <li>To improve system functionality</li>
                    <li>To communicate important updates</li>
                </ul>
            </div>

            <div class="privacy-section">
                <h3 class="section-title"><i class="fas fa-lock"></i> Data Protection</h3>
                <p class="privacy-text">We implement appropriate security measures to protect your personal information against unauthorized access, alteration, or disclosure.</p>
            </div>

            <div class="privacy-section">
                <h3 class="section-title"><i class="fas fa-envelope"></i> Contact Information</h3>
                <div class="contact-card">
                    <i class="fas fa-headset"></i>
                    <p>If you have any questions about this privacy policy, please contact our support team.</p>
                </div>
            </div>
        </div>
    </div>
</div>
